{
  // Cloudflare Workers static-assets deploy. One bundle serves at two mount
  // points: hotstove.io, the canonical home, where a request path is already
  // an asset path; and hedgertronic.com/games/hot-stove, where every path
  // carries a prefix that misses the asset manifest and worker.js strips it
  // back before refetching. www.hotstove.io is routed only so the worker can
  // 301 it at the apex — a hostname off the route list never reaches us.
  "routes": [
    { "pattern": "hotstove.io/*", "zone_name": "hotstove.io" },
    { "pattern": "www.hotstove.io/*", "zone_name": "hotstove.io" },
    { "pattern": "hedgertronic.com/games/hot-stove*", "zone_name": "hedgertronic.com" }
  ],
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hot-stove",
  "main": "worker.js",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // On the hedgertronic.com route every request arrives prefixed
    // (/games/hot-stove/...), and every prefixed path misses the manifest.
    // Without run_worker_first the asset layer short-circuits NAVIGATION
    // requests (Sec-Fetch-Mode: navigate) at that miss — applying
    // not_found_handling without ever invoking the worker — so browsers got
    // 404s while curl and fetch() reached the worker and saw a healthy site.
    // The worker must own every request.
    //
    // not_found_handling stays at the default (plain 404) because the worker
    // resolves misses itself, by request type: a navigation redirects to the
    // game on that host, a subresource stays a 404. Serving dist/404.html
    // here instead is what caused an infinite redirect loop at a domain
    // root — that page sends browsers to the game, which at the apex is
    // itself a missing root asset that served the same page again.
    "run_worker_first": true
  }
}
